{
  "name": "shockmate",
  "version": "0.31.0",
  "private": true,
  "description": "Chess tactics, openings and endgames as short fights against Glitch, for two kids on a phone.",
  "homepage": "https://dirac1974.github.io/shockmate/",
  "repository": { "type": "git", "url": "https://github.com/dirac1974/shockmate.git" },
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "python -m http.server 8765 --directory web",
    "test": "npm run test:js && npm run test:py && npm run check",
    "test:js": "node tools/run_suites.js js",
    "test:py": "python tests/test_encounters.py && python tests/test_voice_lines.py",
    "check": "node tools/run_suites.js check",
    "e2e": "node tools/run_suites.js e2e"
  }
}
